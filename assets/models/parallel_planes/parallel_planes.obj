# Blender 5.0.0
# www.blender.org
o p1
usemtl p1
v -1.000000 0.000000 1.000000
v 1.000000 0.000000 1.000000
v -1.000000 0.000000 -1.000000
v 1.000000 0.000000 -1.000000
vn -0.0000 1.0000 -0.0000
s 0
f 1//1 2//1 4//1 3//1
o p2
usemtl p2
v -1.000000 0.000000 -1.000000
v 1.000000 0.000000 -1.000000
v -1.000000 0.000000 -3.000000
v 1.000000 0.000000 -3.000000
vn -0.0000 1.0000 -0.0000
s 0
f 5//2 6//2 8//2 7//2
o light
usemtl light
v 0.500000 1.000000 -0.500000
v -0.500000 1.000000 -0.500000
v 0.500000 1.000000 -1.500000
v -0.500000 1.000000 -1.500000
vn -0.0000 -1.0000 -0.0000
s 0
f 9//3 10//3 12//3 11//3
